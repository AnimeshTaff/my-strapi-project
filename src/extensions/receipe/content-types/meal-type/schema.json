{
  "kind": "collectionType",
  "collectionName": "meal_types",
  "info": {
    "singularName": "meal-type",
    "pluralName": "meal-types",
    "displayName": "Meal Type"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "recipe": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::receipe.recipe",
      "inversedBy": "meal_types"
    }
  }
}
